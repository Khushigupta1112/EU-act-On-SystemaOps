# ─────────────────────────────────────────────────────────────────────────────
# SystemaOps AI Compliance Platform — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in all required values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# All secrets must be rotated before production deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────

# Environment: development | staging | production
ENVIRONMENT=development

# Application version (used in Docker image tags and API responses)
APP_VERSION=0.1.0

# Enable debug mode (never true in production)
DEBUG=true

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY — CRITICAL: Rotate ALL secrets before production
# ─────────────────────────────────────────────────────────────────────────────

# JWT signing secret — minimum 32 characters, cryptographically random
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars!!

# JWT algorithm (HS256 for single-server, RS256 for distributed)
ALGORITHM=HS256

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# API key for internal service-to-service calls (optional)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — PostgreSQL 16
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL superuser password for the systemaops database user
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=systemaops_dev

# Full async database connection URL (used by SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://systemaops:systemaops_dev@localhost:5432/systemaops

# Sync database URL (used by Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://systemaops:systemaops_dev@localhost:5432/systemaops

# Test database URL (used by pytest)
TEST_DATABASE_URL=postgresql+asyncpg://systemaops:systemaops_dev@localhost:5432/systemaops_test

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Exposed host port for PostgreSQL (Docker only)
POSTGRES_PORT=5432

# ─────────────────────────────────────────────────────────────────────────────
# CACHE / QUEUE — Redis 7
# ─────────────────────────────────────────────────────────────────────────────

# Redis auth password — must match redis-server --requirepass value
REDIS_PASSWORD=redis_dev

# Full Redis URL (used by app and task workers)
REDIS_URL=redis://:redis_dev@localhost:6379/0

# Redis database index for Celery task broker (separate from cache)
CELERY_BROKER_URL=redis://:redis_dev@localhost:6379/1

# Redis database index for Celery result backend
CELERY_RESULT_BACKEND=redis://:redis_dev@localhost:6379/2

# Exposed host port for Redis (Docker only)
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
# CORS — Frontend origins allowed to call the API
# ─────────────────────────────────────────────────────────────────────────────

# JSON array of allowed origins — no trailing slashes
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND — Next.js
# ─────────────────────────────────────────────────────────────────────────────

# Public API URL visible in browser (must be reachable from client)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal API URL for server-side rendering (within Docker network)
INTERNAL_API_URL=http://backend:8000

# Exposed host port for the frontend dev server
FRONTEND_PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — FastAPI service port
# ─────────────────────────────────────────────────────────────────────────────

BACKEND_PORT=8000

# ─────────────────────────────────────────────────────────────────────────────
# ADMINER — Database administration UI
# ─────────────────────────────────────────────────────────────────────────────

ADMINER_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# AI / LLM PROVIDERS (optional — required for AI analysis features)
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI organization ID (optional)
OPENAI_ORG_ID=

# Default OpenAI model for compliance analysis
OPENAI_MODEL=gpt-4o

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Default Anthropic model
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Maximum tokens per LLM request (cost control)
LLM_MAX_TOKENS=4096

# LLM request timeout in seconds
LLM_TIMEOUT_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL — Transactional email (invitations, alerts, reports)
# ─────────────────────────────────────────────────────────────────────────────

# SMTP server hostname
SMTP_HOST=

# SMTP port (587 for STARTTLS, 465 for SSL, 25 for plain)
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=

# SMTP authentication password
SMTP_PASSWORD=

# Whether to use TLS (true | false)
SMTP_TLS=true

# Sender address for all system emails
EMAILS_FROM_EMAIL=noreply@systemaops.local

# Sender display name
EMAILS_FROM_NAME=SystemaOps Platform

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE — File uploads (evidence documents, exports)
# ─────────────────────────────────────────────────────────────────────────────

# Storage backend: local | s3 | azure | gcs
STORAGE_BACKEND=local

# Local filesystem path for uploads (relative to backend container)
LOCAL_STORAGE_PATH=/app/uploads

# AWS S3 settings (required when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# Azure Blob Storage settings (required when STORAGE_BACKEND=azure)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=

# Maximum upload file size in megabytes
MAX_UPLOAD_SIZE_MB=50

# ─────────────────────────────────────────────────────────────────────────────
# MONITORING & OBSERVABILITY (optional)
# ─────────────────────────────────────────────────────────────────────────────

# Sentry DSN for error tracking
SENTRY_DSN=

# Sentry sample rate for performance tracing (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────────────
# MULTI-TENANCY
# ─────────────────────────────────────────────────────────────────────────────

# Default organization plan for new sign-ups: starter | professional | enterprise
DEFAULT_PLAN=starter

# Maximum number of users per organization (per plan limits override this)
MAX_USERS_PER_ORG=10

# Maximum number of AI models tracked per organization (starter plan)
MAX_MODELS_PER_ORG=5

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────

# API rate limit (requests per minute per authenticated user)
RATE_LIMIT_PER_MINUTE=60

# Unauthenticated rate limit (requests per minute per IP)
RATE_LIMIT_ANON_PER_MINUTE=10

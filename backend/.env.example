# SystemaOps Backend Environment Variables
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.

# ---- App Identity --------------------------------------------------------
APP_NAME=SystemaOps
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# ---- Database ------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://systemaops:systemaops_dev@localhost:5432/systemaops
TEST_DATABASE_URL=postgresql+asyncpg://systemaops:systemaops_dev@localhost:5432/systemaops_test

# ---- Security ------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-must-be-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Account lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# ---- CORS ----------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# ---- Redis ---------------------------------------------------------------
REDIS_URL=redis://:redis_dev@localhost:6379/0

# ---- Email (SMTP) --------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@systemaops.io
EMAILS_FROM_NAME=SystemaOps

# ---- File Uploads --------------------------------------------------------
MAX_FILE_SIZE_MB=50

# ---- Rate Limiting -------------------------------------------------------
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- OpenTelemetry -------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=systemaops-backend

# ─────────────────────────────────────────────────────────────────────────────
# SystemaOps — Comprehensive .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS & ENVIRONMENT (NEVER commit these)
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
secrets/
credentials/

# ─────────────────────────────────────────────────────────────────────────────
# PYTHON
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version

# Testing
.pytest_cache/
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
*.cover
*.py,cover
nosetests.xml
junit.xml
test-results/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Linters
.ruff_cache/

# Packaging
*.whl

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Poetry
poetry.lock  # Keep this in version control if using Poetry — remove this line if so

# pyproject / setup
pip-wheel-metadata/

# ─────────────────────────────────────────────────────────────────────────────
# NODE / JAVASCRIPT / TYPESCRIPT
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
.next/
.nuxt/
out/
dist/
build/
.output/
.cache/
.turbo/

# Testing
coverage/
.nyc_output/
jest_html_reporters_attachments/

# Storybook
storybook-static/

# Misc
*.tsbuildinfo
next-env.d.ts

# ─────────────────────────────────────────────────────────────────────────────
